{
  "name": "OrdemProducao",
  "type": "object",
  "properties": {
    "numero_op": {
      "type": "string",
      "description": "N\u00famero autom\u00e1tico (PREFIXO-AAAA-NNNN). Ex: OP-2026-0001, OR-2026-0001, OF-2026-0001"
    },
    "tipo_ordem": {
      "type": "string",
      "enum": [
        "op",
        "or",
        "of"
      ],
      "default": "op",
      "description": "Tipo da ordem: op (Produ\u00e7\u00e3o), or (Reforma), of (Fabrica\u00e7\u00e3o)"
    },
    "ordem_visualizacao": {
      "type": "integer",
      "description": "Posi\u00e7\u00e3o na sequ\u00eancia de visualiza\u00e7\u00e3o dos cards no Suporte Industrial (apenas para ordens OR/OF)"
    },
    "ordem_montagem": {
      "type": "integer",
      "description": "Posi\u00e7\u00e3o na sequ\u00eancia de visualiza\u00e7\u00e3o dos cards na tela de Montagem"
    },
    "ordem_compra": {
      "type": "string",
      "description": "N\u00famero da Ordem de Compra (O.C)"
    },
    "equipamento_principal": {
      "type": "string",
      "description": "Equipamento principal da OP"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome/Apelido do respons\u00e1vel pela OP"
    },
    "responsavel_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela OP"
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos arquivos anexados"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "expedicao",
        "coleta",
        "finalizado",
        "cancelada"
      ],
      "default": "em_andamento",
      "description": "Status calculado automaticamente: em_andamento, expedicao, coleta, finalizado ou cancelada"
    },
    "edicao_liberada_para": {
      "type": "string",
      "description": "ID do usu\u00e1rio com edi\u00e7\u00e3o tempor\u00e1ria liberada nesta OP"
    },
    "edicao_liberada_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio com edi\u00e7\u00e3o tempor\u00e1ria liberada nesta OP"
    },
    "edicao_liberada_expira_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expira\u00e7\u00e3o da libera\u00e7\u00e3o tempor\u00e1ria de edi\u00e7\u00e3o"
    },
    "edicao_liberada_por": {
      "type": "string",
      "description": "Email do administrador que liberou a edi\u00e7\u00e3o tempor\u00e1ria"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data de lan\u00e7amento da OP"
    }
  },
  "required": [
    "numero_op",
    "equipamento_principal",
    "cliente",
    "responsavel"
  ]
}